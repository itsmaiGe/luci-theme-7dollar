#!/bin/sh
# Register the 7Dollar theme and make it the active one on first install.

[ -f /etc/config/7dollar ] || printf "\nconfig theme 'main'\n\toption palette 'clay'\n\toption mode 'auto'\n\toption plugin_openclash '0'\n" > /etc/config/7dollar

uci -q batch <<-UCI
	set luci.themes.7Dollar=/luci-static/7dollar
	set luci.main.mediaurlbase=/luci-static/7dollar
	commit luci
UCI

rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache/ 2>/dev/null
exit 0
